class Solution { //TC: O(N*M*M) => O(N*M^2) T.L.E
    int m, n;
    int MOD = 1000_000_000 + 7;
    long t[][][];
    public int zigZagArrays(int n, int l, int r) {
        this.m = r-l+1;
        this.n = n;

        //[2001][2001][2]
        this.t = new long[n+1][m+1][2];
        for(int prevVal = 1; prevVal <= m; prevVal++){
            t[n][prevVal][0] = 1;
            t[n][prevVal][1] = 1;
        }

        for(int i=n-1; i>=0; i--){
            for(int prevVal=1; prevVal <= m; prevVal++){

                //increasing
                for(int nxtVal = prevVal+1; nxtVal<=m; nxtVal++){
                    t[i][prevVal][1] = (t[i][prevVal][1] + t[i+1][nxtVal][0]) %MOD;
                }
                //decreasing
                for(int nxtVal = 1; nxtVal<prevVal; nxtVal++){
                    t[i][prevVal][0] = (t[i][prevVal][0] + t[i+1][nxtVal][1]) %MOD;
                }
            }
        }

        long res = 0;

        for(int startVal=1; startVal<=m; startVal++){
            res = (res + t[1][startVal][1])%MOD;

            res = (res + t[1][startVal][0]) %MOD;
        }

        return (int)res;
    }
}